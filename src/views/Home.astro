---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { apps, counts, type Lang } from '../data/apps';
import { t, site, localePath } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const tiles = ['vulcainvpn', 'sideby', 'fidele', 'topotree'].map((slug) => apps.find((a) => a.slug === slug)!);
const w = s.work;
const tileHref = (a: (typeof apps)[number]) => (a.hasPage ? localePath(lang, `/apps/${a.slug}`) : a.website?.[lang] ?? a.playUrl!);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://galernestudio.com/#organization',
    name: 'Galerne Studio',
    url: 'https://galernestudio.com',
    logo: 'https://galernestudio.com/logo.png',
    email: site.email,
    founder: { '@type': 'Person', name: 'Pierre Libran' },
    address: { '@type': 'PostalAddress', addressLocality: 'Lyon', addressCountry: 'FR' },
    sameAs: [site.x],
    owns: apps.map((a) => ({
      '@type': 'SoftwareApplication',
      name: a.name,
      url: a.hasPage ? new URL(localePath(lang, `/apps/${a.slug}`), Astro.site).href : a.website?.[lang] ?? a.playUrl,
      operatingSystem: a.kinds.map((k) => (k === 'android' ? 'Android' : 'Windows')).join(', '),
      image: `https://galernestudio.com/icons/${a.slug}.webp`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://galernestudio.com/#website',
    name: 'Galerne Studio',
    url: 'https://galernestudio.com',
    inLanguage: lang,
    publisher: { '@id': 'https://galernestudio.com/#organization' },
  },
];
---
<Base lang={lang} path="/" jsonLd={jsonLd}>
  <section class="container hero">
    <div class="hero-text">
      <p class="eyebrow">{s.hero.eyebrow}</p>
      <h1>{s.hero.title}</h1>
      <p class="lead">{s.hero.sub}</p>
      <div class="actions">
        <a class="btn btn-dark" href="#apps">{s.hero.cta1}</a>
        <a class="btn btn-ghost" href="#contact">{s.hero.cta2}</a>
      </div>
      <div class="stats">
        <span><strong>{counts.total}</strong>{s.hero.stats[0]}</span>
        <span><strong>{counts.android}</strong>{s.hero.stats[1]}</span>
        <span><strong>{counts.windows}</strong>{s.hero.stats[2]}</span>
      </div>
    </div>
    <div class="tiles">
      {tiles.map((a) => (
        <a class="tile" href={tileHref(a)} style={`background:${a.bg};color:${a.fg}`}>
          <img src={`/icons/${a.slug}.webp`} alt="" width="56" height="56" />
          <span>{a.name}</span>
        </a>
      ))}
    </div>
  </section>

  <section id="apps" class="band">
    <div class="container section">
      <div class="section-head">
        <div>
          <h2 class="h2">{s.apps.title}</h2>
          <p class="muted">{s.apps.sub}</p>
        </div>
        <div class="filters" role="group" aria-label={s.apps.filterLabel}>
          <button type="button" class="filter" data-filter="all" aria-pressed="true">{s.apps.filters.all}</button>
          <button type="button" class="filter" data-filter="android" aria-pressed="false">{s.apps.filters.android}</button>
          <button type="button" class="filter" data-filter="windows" aria-pressed="false">{s.apps.filters.windows}</button>
          <button type="button" class="filter" data-filter="web" aria-pressed="false">{s.apps.filters.web}</button>
        </div>
      </div>

      <div class="grid">
        {apps.map((a) => (
          <article class="card" data-kinds={a.kinds.join(' ')}>
            <div class="card-head">
              <img class="app-icon" src={`/icons/${a.slug}.webp`} alt="" width="56" height="56" loading="lazy" />
              <div>
                <h3>{a.name}</h3>
                <span class="platform">{a.platform[lang]}</span>
              </div>
            </div>
            <p>{a.desc[lang]}</p>
            <div class="card-links">
              {a.playUrl && <a class="btn btn-dark btn-sm" href={a.playUrl}>{s.apps.play}</a>}
              {a.msStoreUrl && <a class="btn btn-dark btn-sm" href={a.msStoreUrl}>{s.apps.msStore}</a>}
              {a.website && !a.playUrl && !a.msStoreUrl && (
                <a class="btn btn-dark btn-sm" href={a.website[lang]}>{s.apps.website}</a>
              )}
              {a.website && (a.playUrl || a.msStoreUrl) && (
                <a class="link" href={a.website[lang]} aria-label={s.apps.opensIn(a.name)}>{s.apps.website}</a>
              )}
              {a.hasPage && (
                <a class="link" href={localePath(lang, `/apps/${a.slug}`)} aria-label={`${s.apps.details}: ${a.name}`}>{s.apps.details}</a>
              )}
            </div>
          </article>
        ))}
      </div>

      <div class="also">
        <div class="also-main">
          <img class="app-icon" src="/icons/firefly.webp" alt="" width="56" height="56" loading="lazy" />
          <div>
            <span class="eyebrow">{s.also.eyebrow}</span>
            <p class="muted" style="font-size:16px"><strong style="color:var(--ink)">The Little Firefly</strong>: {s.also.desc}</p>
          </div>
        </div>
        <a class="link" href={site.firefly} style="font-size:14px">{s.also.visit}</a>
      </div>
    </div>
  </section>

  <section id="about" class="container about">
    <div class="about-text">
      <h2 class="h2">{s.about.title}</h2>
      <p class="muted">{s.about.body}</p>
    </div>
    <div class="values">
      {s.about.values.map((v) => (
        <div class="value">
          <Icon name={v.icon} />
          <h3>{v.title}</h3>
          <p>{v.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="work" class="band">
    <div class="container section work">
      <div class="work-text">
        <p class="eyebrow">{w.eyebrow}</p>
        <h2 class="h2">{w.title}</h2>
        <p class="muted">{w.sub}</p>
        <ul class="work-points">
          {w.points.map((p) => <li>{p}</li>)}
        </ul>
      </div>

      <form class="work-form" id="work-form" action="/api/contact" method="post" novalidate>
        <input type="hidden" name="lang" value={lang} />
        <div class="hp" aria-hidden="true">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <div class="row">
          <label class="field">
            <span>{w.name}</span>
            <input type="text" name="name" required maxlength="120" autocomplete="name" />
          </label>
          <label class="field">
            <span>{w.email}</span>
            <input type="email" name="email" required maxlength="200" autocomplete="email" />
          </label>
        </div>
        <label class="field">
          <span>{w.company}</span>
          <input type="text" name="company" maxlength="160" autocomplete="organization" />
        </label>
        <fieldset class="field">
          <legend>{w.type}</legend>
          <div class="chips">
            {w.types.map((label, i) => (
              <label class="chip"><input type="radio" name="type" value={label} required checked={i === 0} /><span>{label}</span></label>
            ))}
          </div>
        </fieldset>
        <label class="field">
          <span>{w.timeline}</span>
          <select name="timeline">
            {w.timelines.map((b) => <option value={b}>{b}</option>)}
          </select>
        </label>
        <label class="field">
          <span>{w.message}</span>
          <textarea name="message" rows="6" required minlength="20" maxlength="5000" placeholder={w.messageHint}></textarea>
        </label>
        {site.turnstileSiteKey && (
          <>
            <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey} data-language={lang}></div>
            <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
          </>
        )}
        <p class="form-note">{w.consent}</p>
        <div class="form-actions">
          <button class="btn btn-dark" type="submit" data-sending={w.sending}>{w.send}</button>
          <p class="form-status" role="status" aria-live="polite" hidden></p>
        </div>
        <p class="form-error" role="alert" hidden>{w.error} <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
        <p class="form-ok" role="status" hidden>{w.ok}</p>
      </form>
    </div>
  </section>

  <section id="contact" class="container contact">
    <div class="contact-box">
      <div>
        <h2>{s.contact.title}</h2>
        <p>{s.contact.sub}</p>
      </div>
      <div class="email-row">
        <a class="btn btn-mint" href={`mailto:${site.email}`}>{site.email}</a>
        <button type="button" class="btn btn-copy" data-copy={site.email} data-copied={s.contact.copied} aria-label={s.contact.copyLabel}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <span>{s.contact.copy}</span>
        </button>
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-kinds]');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      cards.forEach((c) => {
        c.hidden = f !== 'all' && !c.dataset.kinds!.split(' ').includes(f);
      });
    }),
  );

  // Copy email
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector('span')!;
    const original = label.textContent;
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy!;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      label.textContent = btn.dataset.copied!;
      btn.classList.add('is-copied');
      setTimeout(() => {
        label.textContent = original;
        btn.classList.remove('is-copied');
      }, 2000);
    });
  });

  // Project form
  const form = document.querySelector<HTMLFormElement>('#work-form');
  if (form) {
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const okMsg = form.querySelector<HTMLElement>('.form-ok')!;
    const errMsg = form.querySelector<HTMLElement>('.form-error')!;
    const idle = submit.textContent;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errMsg.hidden = true;
      if (!form.reportValidity()) return;
      submit.disabled = true;
      submit.textContent = submit.dataset.sending!;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.querySelectorAll<HTMLElement>('.row, .field, .form-note, .form-actions, .cf-turnstile').forEach((el) => (el.hidden = true));
        okMsg.hidden = false;
        okMsg.focus?.();
      } catch {
        errMsg.hidden = false;
        // @ts-ignore Turnstile global, when enabled
        window.turnstile?.reset?.();
      } finally {
        submit.disabled = false;
        submit.textContent = idle;
      }
    });
  }
</script>
