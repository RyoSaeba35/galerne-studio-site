---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Wind from '../components/Wind.astro';
import Compass from '../components/Compass.astro';
import { apps, counts, featured, type Lang } from '../data/apps';
import { t, site, localePath } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const w = s.work;
const flagship = featured.map((slug) => apps.find((a) => a.slug === slug)!);
const ordered = [...flagship, ...apps.filter((a) => !featured.includes(a.slug))];
const INITIAL = 5;
const appHref = (a: (typeof apps)[number]) => (a.hasPage ? localePath(lang, `/apps/${a.slug}`) : a.website?.[lang] ?? a.playUrl!);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://galernestudio.com/#organization',
    name: 'Galerne Studio',
    url: 'https://galernestudio.com',
    logo: 'https://galernestudio.com/logo.png',
    email: site.email,
    founder: { '@type': 'Person', name: 'Pierre Libran' },
    address: { '@type': 'PostalAddress', addressLocality: 'Lyon', addressCountry: 'FR' },
    sameAs: [site.x],
    owns: apps.map((a) => ({
      '@type': a.content ? 'WebSite' : 'SoftwareApplication',
      name: a.name,
      url: a.hasPage ? new URL(localePath(lang, `/apps/${a.slug}`), Astro.site).href : a.website?.[lang] ?? a.playUrl,
      operatingSystem: a.content ? undefined : a.kinds.map((k) => (k === 'android' ? 'Android' : 'Windows')).join(', '),
      image: `https://galernestudio.com/icons/${a.slug}.webp`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://galernestudio.com/#website',
    name: 'Galerne Studio',
    url: 'https://galernestudio.com',
    inLanguage: lang,
    publisher: { '@id': 'https://galernestudio.com/#organization' },
  },
];
---
<Base lang={lang} path="/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero-stage">
    <Wind />
    <div class="container hero-inner">
      <p class="kicker">{s.hero.eyebrow}</p>
      <h1>{s.hero.title}</h1>
      <p class="lead">{s.hero.sub}</p>
      <div class="actions">
        <a class="btn btn-mint" href="#apps">{s.hero.cta1}</a>
        <a class="btn btn-line" href="#work">{s.nav.work}</a>
      </div>
    </div>
    </div>
    <div class="shelf">
      <div class="container shelf-inner">
        <span class="shelf-label">{s.hero.shelf}</span>
        <ul class="shelf-apps">
          {flagship.map((a) => (
            <li><a href={appHref(a)}><img src={`/icons/${a.slug}.webp`} alt="" width="40" height="40" /><span>{a.name}</span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="apps" class="container section">
    <div class="section-head">
      <div>
        <h2 class="h2">{s.apps.title}</h2>
        <p class="muted">{s.apps.sub(counts.total, counts.android, counts.windows)}</p>
      </div>
      <div class="filters" role="group" aria-label={s.apps.filterLabel}>
        <button type="button" class="filter" data-filter="all" aria-pressed="true">{s.apps.filters.all}</button>
        <button type="button" class="filter" data-filter="android" aria-pressed="false">{s.apps.filters.android}</button>
        <button type="button" class="filter" data-filter="windows" aria-pressed="false">{s.apps.filters.windows}</button>
        <button type="button" class="filter" data-filter="web" aria-pressed="false">{s.apps.filters.web}</button>
      </div>
    </div>

    <ul class="catalog" id="catalog">
      {ordered.map((a, i) => (
        <li class="entry" data-kinds={a.kinds.join(' ')} data-extra={i >= INITIAL ? '' : undefined}>
          <img class="app-icon" src={`/icons/${a.slug}.webp`} alt="" width="64" height="64" loading="lazy" />
          <div>
            <h3><a href={appHref(a)}>{a.name}</a></h3>
            <span class="platform">{a.platform[lang]}</span>
          </div>
          <p>{a.desc[lang]}</p>
          <div class="entry-links">
            {a.hasPage && (
              <a class="link" href={localePath(lang, `/apps/${a.slug}`)} aria-label={`${s.apps.details}: ${a.name}`}>{s.apps.details}</a>
            )}
            {a.website && (a.playUrl || a.msStoreUrl) && (
              <a class="link" href={a.website[lang]} aria-label={s.apps.opensIn(a.name)}>{s.apps.website}</a>
            )}
            {a.playUrl && <a class="btn btn-strong btn-sm" href={a.playUrl}><Icon name="play" size={14} />{s.apps.play}</a>}
            {a.msStoreUrl && <a class="btn btn-strong btn-sm" href={a.msStoreUrl}>{s.apps.msStore}</a>}
            {a.website && !a.playUrl && !a.msStoreUrl && (
              <a class="btn btn-strong btn-sm" href={a.website[lang]}>{s.apps.website}</a>
            )}
          </div>
        </li>
      ))}
    </ul>
    <div class="more" hidden>
      <button type="button" class="btn btn-line" aria-controls="catalog" aria-expanded="false" data-all={s.apps.showAll(ordered.length - INITIAL)} data-less={s.apps.showLess}>
        <span>{s.apps.showAll(ordered.length - INITIAL)}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </button>
    </div>
  </section>

  <section id="about" class="about">
    <div class="container section about-grid">
      <div class="about-title">
        <Compass lang={lang} />
        <h2 class="h2">{s.about.title}</h2>
      </div>
      <div class="about-body">
        <p>{s.about.body}</p>
        <ul class="values">
          {s.about.values.map((v) => (
            <li class="value">
              <Icon name={v.icon} size={24} />
              <h3>{v.title}</h3>
              <p>{v.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="work" class="container section work">
    <div class="work-text">
      <p class="kicker">{w.eyebrow}</p>
      <h2 class="h2">{w.title}</h2>
      <p class="muted">{w.sub}</p>
      <ul class="work-points">
        {w.points.map((p) => <li><Icon name="check" size={20} />{p}</li>)}
      </ul>
    </div>

    <form class="work-form" id="work-form" action="/api/contact" method="post" novalidate>
      <input type="hidden" name="lang" value={lang} />
      <div class="hp" aria-hidden="true">
        <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <div class="row">
        <label class="field">
          <span>{w.name}</span>
          <input type="text" name="name" required maxlength="120" autocomplete="name" />
        </label>
        <label class="field">
          <span>{w.email}</span>
          <input type="email" name="email" required maxlength="200" autocomplete="email" />
        </label>
      </div>
      <label class="field">
        <span>{w.company}</span>
        <input type="text" name="company" maxlength="160" autocomplete="organization" />
      </label>
      <fieldset class="field">
        <legend>{w.type}</legend>
        <div class="chips">
          {w.types.map((label, i) => (
            <label class="chip"><input type="radio" name="type" value={label} required checked={i === 0} /><span>{label}</span></label>
          ))}
        </div>
      </fieldset>
      <label class="field">
        <span>{w.timeline}</span>
        <select name="timeline">
          {w.timelines.map((b) => <option value={b}>{b}</option>)}
        </select>
      </label>
      <label class="field">
        <span>{w.message}</span>
        <textarea name="message" rows="6" required minlength="20" maxlength="5000" placeholder={w.messageHint}></textarea>
      </label>
      {site.turnstileSiteKey && (
        <>
          <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey} data-language={lang}></div>
          <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        </>
      )}
      <p class="form-note">{w.consent}</p>
      <div class="form-actions">
        <button class="btn btn-strong" type="submit" data-sending={w.sending}>{w.send}</button>
        <p class="form-status" role="status" aria-live="polite" hidden></p>
      </div>
      <p class="form-error" role="alert" hidden>{w.error} <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      <p class="form-ok" role="status" hidden>{w.ok}</p>
    </form>
  </section>

  <section id="contact" class="contact">
    <div class="container contact-inner">
      <div>
        <h2>{s.contact.title}</h2>
        <p>{s.contact.sub}</p>
      </div>
      <div class="email-row">
        <a class="btn btn-mint" href={`mailto:${site.email}`}>{site.email}</a>
        <button type="button" class="btn btn-copy" data-copy={site.email} data-copied={s.contact.copied} aria-label={s.contact.copyLabel}>
          <Icon name="copy" size={18} />
          <span>{s.contact.copy}</span>
        </button>
      </div>
    </div>
  </section>
</Base>

<script>
  // Filters + "show all": the first rows show by default, a filter shows every match.
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-kinds]');
  const more = document.querySelector<HTMLElement>('.more')!;
  const moreBtn = more.querySelector<HTMLButtonElement>('button')!;
  const moreLabel = moreBtn.querySelector('span')!;
  let filter = 'all';
  let expanded = false;
  const render = () => {
    cards.forEach((c) => {
      const match = filter === 'all' || c.dataset.kinds!.split(' ').includes(filter);
      const collapsed = filter === 'all' && !expanded && c.hasAttribute('data-extra');
      c.hidden = !match || collapsed;
    });
    more.hidden = filter !== 'all';
    moreBtn.setAttribute('aria-expanded', String(expanded));
    moreLabel.textContent = expanded ? moreBtn.dataset.less! : moreBtn.dataset.all!;
  };
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      filter = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      render();
    }),
  );
  moreBtn.addEventListener('click', () => {
    expanded = !expanded;
    render();
    if (!expanded) document.getElementById('apps')!.scrollIntoView();
  });
  render();

  // Copy email
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector('span')!;
    const original = label.textContent;
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy!;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      label.textContent = btn.dataset.copied!;
      btn.classList.add('is-copied');
      setTimeout(() => {
        label.textContent = original;
        btn.classList.remove('is-copied');
      }, 2000);
    });
  });

  // Project form
  const form = document.querySelector<HTMLFormElement>('#work-form');
  if (form) {
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const okMsg = form.querySelector<HTMLElement>('.form-ok')!;
    const errMsg = form.querySelector<HTMLElement>('.form-error')!;
    const idle = submit.textContent;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errMsg.hidden = true;
      if (!form.reportValidity()) return;
      submit.disabled = true;
      submit.textContent = submit.dataset.sending!;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.querySelectorAll<HTMLElement>('.row, .field, .form-note, .form-actions, .cf-turnstile').forEach((el) => (el.hidden = true));
        okMsg.hidden = false;
        okMsg.focus?.();
      } catch {
        errMsg.hidden = false;
        // @ts-ignore Turnstile global, when enabled
        window.turnstile?.reset?.();
      } finally {
        submit.disabled = false;
        submit.textContent = idle;
      }
    });
  }
</script>
