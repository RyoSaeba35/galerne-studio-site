---
import Base from '../layouts/Base.astro';
import type { Lang } from '../data/apps';
import { t, site } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const fr = lang === 'fr';
---
<Base lang={lang} path="/legal" title={s.legal.title}>
  <article class="container prose">
    <h1>{s.legal.title}</h1>

    <h2>{fr ? 'Éditeur du site' : 'Publisher'}</h2>
    <dl>
      <dt>{fr ? 'Nom' : 'Name'}</dt><dd>Pierre Libran, {fr ? 'entrepreneur individuel (micro-entreprise)' : 'sole trader (micro-entreprise)'}</dd>
      <dt>{fr ? 'Nom commercial' : 'Trading name'}</dt><dd>Galerne Studio</dd>
      <dt>SIRET</dt><dd>[SIRET]</dd>
      <dt>{fr ? 'Adresse' : 'Address'}</dt><dd>[ADRESSE / ADDRESS], France</dd>
      <dt>{fr ? 'E-mail' : 'Email'}</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
      <dt>{fr ? 'Directeur de la publication' : 'Publication director'}</dt><dd>Pierre Libran</dd>
      <dt>{fr ? 'TVA' : 'VAT'}</dt><dd>{fr ? 'TVA non applicable, art. 293 B du CGI' : 'Not subject to VAT (art. 293 B of the French General Tax Code)'}</dd>
    </dl>

    <h2>{fr ? 'Hébergeur' : 'Hosting'}</h2>
    <p>Cloudflare, Inc., 101 Townsend St, San Francisco, CA 94107, {fr ? 'États-Unis' : 'United States'}. www.cloudflare.com</p>

    <h2>{fr ? 'Cookies et mesure d’audience' : 'Cookies and analytics'}</h2>
    <p>{fr
      ? 'Ce site n’utilise aucun cookie et aucun traceur publicitaire. Les polices sont hébergées sur le site lui-même.'
      : 'This site uses no cookies and no advertising trackers. Fonts are served from the site itself.'}</p>
    <p>{fr
      ? 'La fréquentation est mesurée avec Umami, un outil de mesure d’audience auto-hébergé par Galerne Studio (serveur Railway). Umami ne dépose aucun cookie, ne stocke pas votre adresse IP et ne permet pas de vous identifier : il produit uniquement des statistiques agrégées (pages vues, pays, type d’appareil, site de provenance). Conformément aux recommandations de la CNIL sur les outils de mesure d’audience exemptés de consentement, aucun bandeau n’est donc nécessaire.'
      : 'Visits are measured with Umami, an analytics tool self-hosted by Galerne Studio (Railway server). Umami sets no cookies, does not store your IP address and cannot identify you: it only produces aggregate statistics (page views, country, device type, referring site). In line with CNIL guidance on consent-exempt audience measurement, no consent banner is needed.'}</p>

    <h2>{fr ? 'Applications' : 'Apps'}</h2>
    <p>{fr
      ? 'Chaque application dispose de sa propre politique de confidentialité, accessible depuis la page Politiques de confidentialité.'
      : 'Each app has its own privacy policy, listed on the Privacy policies page.'}</p>

    <h2>{fr ? 'Propriété intellectuelle' : 'Intellectual property'}</h2>
    <p>{fr
      ? 'Les contenus de ce site (textes, logos, visuels) appartiennent à Galerne Studio, sauf mention contraire. Toute reproduction sans autorisation est interdite. Google Play est une marque de Google LLC. Microsoft Store et Windows sont des marques de Microsoft Corporation.'
      : 'The content of this site (text, logos, visuals) belongs to Galerne Studio unless stated otherwise. Reproduction without permission is prohibited. Google Play is a trademark of Google LLC. Microsoft Store and Windows are trademarks of Microsoft Corporation.'}</p>
  </article>
</Base>
