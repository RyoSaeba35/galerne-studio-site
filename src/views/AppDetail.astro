---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { apps, appPages, type Lang } from '../data/apps';
import { t, site, localePath } from '../i18n';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const s = t[lang];
const app = apps.find((a) => a.slug === slug)!;
const page = appPages[slug];
const url = new URL(localePath(lang, `/apps/${slug}`), Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: app.name,
    description: page.tagline[lang],
    url,
    applicationCategory: page.category,
    image: `https://galernestudio.com/icons/${slug}-640.webp`,
    operatingSystem: 'Android',
    inLanguage: page.languages,
    ...(app.playUrl && { downloadUrl: app.playUrl, installUrl: app.playUrl }),
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    publisher: { '@type': 'Organization', '@id': 'https://galernestudio.com/#organization', name: 'Galerne Studio', url: 'https://galernestudio.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Galerne Studio', item: new URL(localePath(lang, '/'), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: app.name, item: url },
    ],
  },
];
---
<Base lang={lang} path={`/apps/${slug}`} title={app.name} description={page.tagline[lang]} jsonLd={jsonLd} ogImage={page.ogImage}>
  <nav class="container crumbs" aria-label="Breadcrumb">
    <a href={`${localePath(lang, '/')}#apps`}>{s.appPage.breadcrumb}</a> / <span aria-current="page">{app.name}</span>
  </nav>

  <section class="container app-hero">
    <div class="app-hero-text">
      <img class="app-icon app-icon-lg" src={`/icons/${slug}.webp`} alt="" width="88" height="88" />
      <h1>{app.name}</h1>
      <p class="lead" style="font-size:21px;line-height:1.5">{page.tagline[lang]}</p>
      <div class="actions" style="align-items:center">
        {app.playUrl && <a class="btn btn-dark" href={app.playUrl}>{s.appPage.getPlay}</a>}
        <span class="app-meta">{page.meta[lang]}</span>
      </div>
    </div>
    <div class="shots">
      {page.screenshots.length > 0
        ? page.screenshots.slice(0, 2).map((src, i) => (
            <div class="shot"><img src={src} alt={`${app.name} screenshot ${i + 1}`} width="164" height="356" loading="lazy" /></div>
          ))
        : <img class="shot-placeholder" src={`/icons/${slug}-640.webp`} alt={`${app.name} icon`} width="320" height="320" />}
    </div>
  </section>

  <section class="band">
    <div class="container section">
      <h2 class="h2">{s.appPage.what}</h2>
      <div class="features">
        {page.features.map((f) => (
          <div class="feature">
            <Icon name={f.icon} />
            <h3>{f.title[lang]}</h3>
            <p>{f.body[lang]}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container info">
    <div class="info-card">
      <h2>{s.appPage.privacyTitle}</h2>
      <p>{s.appPage.privacyBody(app.name)}</p>
      <a class="link" href={localePath(lang, `/privacy/${slug}`)}>{s.appPage.privacyLink}</a>
    </div>
    <div class="info-card">
      <h2>{s.appPage.supportTitle}</h2>
      <p>{page.supportHint[lang]}</p>
      <a class="link" href={`mailto:${site.email}?subject=${encodeURIComponent(app.name)}`}>{site.email}</a>
    </div>
  </section>
</Base>
