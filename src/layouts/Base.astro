---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { t, site, localePath } from '../i18n';
import type { Lang } from '../data/apps';

interface Props {
  lang: Lang;
  /** English path of this page, e.g. "/" or "/apps/fidele" */
  path: string;
  title?: string;
  description?: string;
  /** Absolute path of a 1200x630 image in /public */
  ogImage?: string;
  /** Structured data objects, rendered as JSON-LD */
  jsonLd?: Record<string, unknown>[];
}
const { lang, path, title, description, ogImage = '/og/default.png', jsonLd = [] } = Astro.props;
const s = t[lang];
const other: Lang = lang === 'en' ? 'fr' : 'en';
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${s.hero.title}`;
const desc = description ?? s.metaDesc;
const canonical = new URL(localePath(lang, path), Astro.site).href;
const home = localePath(lang, '/');
const homeBase = home === '/' ? '' : home; // "" or "/fr", for anchors like /fr#apps
const ogUrl = new URL(ogImage, Astro.site).href;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={new URL(localePath('en', path), Astro.site).href} />
  <link rel="alternate" hreflang="fr" href={new URL(localePath('fr', path), Astro.site).href} />
  <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', path), Astro.site).href} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0E1C2F" media="(prefers-color-scheme: dark)" />
  <script is:inline>
    // Follow the device setting, unless the visitor picked a theme with the toggle.
    (function () {
      var saved = null;
      try { saved = localStorage.getItem('theme'); } catch (e) {}
      var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (dark) document.documentElement.dataset.theme = 'dark';
    })();
  </script>
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
  <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_GB' : 'fr_FR'} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Galerne Studio" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@galernestudio" />
  <meta name="twitter:image" content={ogUrl} />
  {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  {!site.umami.websiteId.startsWith('PASTE') && (
    <script is:inline defer src={site.umami.src} data-website-id={site.umami.websiteId} data-domains="galernestudio.com" />
  )}
</head>
<body>
  <a class="skip" href="#main">{lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
  <div class="masthead">
  <header class="container header">
    <a class="brand" href={home}>
      <Logo size={34} />
      <span>Galerne Studio</span>
    </a>
    <nav class="nav" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
      <a href={`${homeBase || '/'}#apps`}>{s.nav.apps}</a>
      <a href={`${homeBase || '/'}#about`}>{s.nav.about}</a>
      <a href={`${homeBase || '/'}#work`}>{s.nav.work}</a>
      <a href={`${homeBase || '/'}#contact`}>{s.nav.contact}</a>
      <span class="nav-tools">
        <button type="button" class="theme-toggle" data-to-dark={s.nav.toDark} data-to-light={s.nav.toLight} aria-label={s.nav.toDark}>
          <svg class="sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <a class="lang" href={localePath(other, path)} hreflang={other} lang={other} aria-label={s.nav.switchLabel}>{s.nav.switchText}</a>
      </span>
    </nav>
  </header>
  </div>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <span>© {new Date().getFullYear()} Galerne Studio · {s.footer.rights}</span>
      <div class="footer-links">
        <a href={localePath(lang, '/legal')}>{s.footer.legal}</a>
        <a href={localePath(lang, '/privacy')}>{s.footer.privacy}</a>
        <a href={site.x} rel="me">X @galernestudio</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    // Theme toggle
    (function () {
      var btn = document.querySelector('.theme-toggle');
      var root = document.documentElement;
      var metas = document.querySelectorAll('meta[name="theme-color"]');
      function sync() {
        var dark = root.dataset.theme === 'dark';
        btn.setAttribute('aria-label', dark ? btn.dataset.toLight : btn.dataset.toDark);
        btn.setAttribute('aria-pressed', String(dark));
        metas.forEach(function (m) { m.content = dark ? '#0E1C2F' : '#FFFFFF'; });
      }
      // While no choice is saved, follow the device if it switches (e.g. night mode at sunset).
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (err) {}
        if (saved) return;
        if (e.matches) root.dataset.theme = 'dark'; else delete root.dataset.theme;
        sync();
      });
      btn.addEventListener('click', function () {
        if (root.dataset.theme === 'dark') delete root.dataset.theme; else root.dataset.theme = 'dark';
        try { localStorage.setItem('theme', root.dataset.theme === 'dark' ? 'dark' : 'light'); } catch (e) {}
        sync();
      });
      sync();
    })();

    // Open every link that leaves galernestudio.com in a new tab.
    document.querySelectorAll('a[href]').forEach(function (a) {
      if ((a.protocol === 'http:' || a.protocol === 'https:') && a.host !== location.host) {
        a.target = '_blank';
        a.rel = (a.rel ? a.rel + ' ' : '') + 'noopener noreferrer';
      }
    });
  </script>
</body>
</html>
