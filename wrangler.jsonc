{
  "name": "galerne-studio-site",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only the contact form endpoint runs the worker; every other request is served straight from ./dist.
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Email Routing must be enabled on galernestudio.com and CONTACT_TO must be a
  // verified destination address (Email > Email Routing > Destination addresses).
  "send_email": [{ "name": "CONTACT_EMAIL" }],
  "vars": {
    "CONTACT_FROM": "form@galernestudio.com"
  },
  // 5 form submissions per minute per IP.
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
